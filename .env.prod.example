# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=otboo
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
