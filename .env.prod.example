# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=otboo
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true

# Search / AWS OpenSearch Service
SEARCH_ENDPOINT=

# AWS / S3
AWS_REGION=ap-northeast-2
S3_BUCKET=otboo-prod-assets-310567229825-ap-northeast-2
S3_PRESIGNED_URL_EXPIRATION_SECONDS=600
IMAGE_MAX_FILE_SIZE_BYTES=10485760

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# WebSocket handshake를 허용할 프론트엔드 Origin 목록입니다.
# 실제 배포 시 운영 프론트엔드 도메인으로 변경합니다. 여러 개인 경우 콤마로 구분합니다.
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://otboo.com,https://www.otboo.com,https://admin.otboo.com


# KAKAO
KAKAO_REST_API_KEY=

#KMA
KMA_API_KEY=

# OAuth
# Client ID는 ECS environment, Client Secret은 SSM Parameter Store를 통해 ECS secrets로 주입합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
