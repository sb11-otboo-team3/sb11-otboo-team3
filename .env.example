# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=otboo
DB_USERNAME=otboo
DB_PASSWORD=otboo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
SEARCH_ENDPOINT=http://localhost:9200

# AWS / S3
AWS_REGION=ap-northeast-2
S3_BUCKET=CHANGE_ME_LOCAL_BUCKET
S3_PRESIGNED_URL_EXPIRATION_SECONDS=600
IMAGE_MAX_FILE_SIZE_BYTES=10485760

# 로컬에서 AWS SDK가 사용할 CLI Profile
# S3 등 AWS 연동 기능을 로컬에서 테스트할 때 사용
AWS_PROFILE=otboo

# JWT
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_256BIT_SECRET
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000


# KAKAO
KAKAO_REST_API_KEY=

#KMA
KMA_API_KEY=

# OpenRouter (LLM 추천 보정, 이미지 기반 속성 태깅)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_VISION_MODEL=dots-studio/dots-3-note-preview:free

# 추천 LLM 보정 켜고 끄기 (시연/리허설 중 쿼터 소진 방지용, 기본 true)
RECOMMENDATION_LLM_ENABLED=true

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
